{
  "name": "ctofconverter",
  "version": "1.0.0",
  "description": "Celsius to Fahrenheit converter with Next.js integration",
  "private": true,
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/generate-sitemap.js",
    "build": "next build",
    "postinstall": "echo 'Sitemap auto-generation configured'",
    "postbuild": "node scripts/submit-indexnow.js",
    "start": "next start",
    "lint": "next lint",
    "export": "next build && next export",
    "generate:sitemap": "node scripts/generate-sitemap.js"
  },
  "dependencies": {
    "@vercel/og": "^0.8.6",
    "next": "^16.2.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "styled-jsx": "5.1.6"
  },
  "devDependencies": {
    "@types/node": "^20.19.25",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.6",
    "google-auth-library": "^11.0.1",
    "googleapis": "^174.0.1",
    "https-proxy-agent": "^9.1.0",
    "typescript": "^5.0.0",
    "undici": "^7.29.0"
  },
  "overrides": {
    "postcss": "^8.4.32"
  }
}
